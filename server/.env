# 서버 포트
PORT=3005

# CORS 허용 origin (클라이언트 URL)
CORS_ORIGIN=http://localhost:3000

# STUN
NEXT_PUBLIC_STUN_SERVER=stun.l.google.com


NEXT_PUBLIC_SOCKET_URL=http://localhost:3005

ENABLE_MONITORING=true

MEDIASOUP_NUM_WORKERS=1

# WebRtcServer 설정 (단일 포트 다중화)
# true: 단일 포트(10000)로 모든 Transport 다중화
# false: 기존 방식 (포트 범위 10000-10200 사용)
MEDIASOUP_WEBRTC_SERVER_ENABLED=true
