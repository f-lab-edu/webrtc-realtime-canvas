# ============================================
# Docker 환경변수 템플릿
# 사용법: docker-compose --env-file .env.docker up
# ============================================

# 서버 설정
NODE_ENV=production
PORT=3005

# CORS 설정 (로컬 개발 클라이언트)
CORS_ORIGIN=http://localhost:3000

# ============================================
# mediasoup 네트워크 설정
# ============================================

# 수신 IP (컨테이너 내부)
MEDIASOUP_LISTEN_IP=0.0.0.0

# 공지 IP (클라이언트에 전달)
# - Windows/Mac Docker Desktop: host.docker.internal
# - Linux: 호스트 실제 IP (예: 192.168.1.100)
# - 클라우드 배포: 공인 IP
MEDIASOUP_ANNOUNCED_IP=host.docker.internal

# ============================================
# 모니터링 설정
# ============================================

# 모니터링 활성화 (true/false)
ENABLE_MONITORING=true

# 측정 간격 (밀리초)
METRICS_INTERVAL_MS=1000

# CSV 파일 출력 디렉토리
METRICS_OUTPUT_DIR=/app/metrics

# 콘솔 출력 여부 (true/false)
METRICS_CONSOLE_OUTPUT=true
