# ============================================
# Docker 환경변수 템플릿
# 사용법: docker-compose --env-file .env.docker up
# ============================================

# 서버 설정
NODE_ENV=production
PORT=3100

# CORS 설정 (로컬 개발 클라이언트)
CORS_ORIGIN=http://localhost:3000

# ============================================
# mediasoup 네트워크 설정
# ============================================

# 수신 IP (컨테이너 내부)
MEDIASOUP_LISTEN_IP=0.0.0.0

# 공지 IP (클라이언트에 전달)
# - 로컬 테스트: 127.0.0.1 (브라우저와 Docker가 같은 호스트)
# - Linux: 호스트 실제 IP (예: 192.168.1.100)
# - 클라우드 배포: 공인 IP
# 주의: host.docker.internal은 Docker 내부 전용이므로 브라우저에서 접근 불가
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Worker 수
# - WebRtcServer 단일 포트 모드 (Pinggy 터널): 1
# - 멀티 Worker 모드 (AWS 클라우드): CPU 코어 수 (예: 2)
MEDIASOUP_NUM_WORKERS=1

# ============================================
# WebRtcServer 설정 (단일 포트 다중화)
# ============================================

# WebRtcServer 활성화 여부
# - true: 단일 포트(10000)로 모든 Transport 다중화 (Pinggy 터널용)
# - false: 기존 방식 (포트 범위 10000-10200 사용, 멀티 Worker 가능)
MEDIASOUP_WEBRTC_SERVER_ENABLED=true

# WebRtcServer 포트 (단일 포트 모드에서만 사용)
MEDIASOUP_WEBRTC_SERVER_PORT=10000

# WebRtcServer 공지 주소 (클라이언트에 전달)
# - 로컬 테스트: 127.0.0.1:10000
# - Pinggy 터널: xxx.pinggy.link:49349 (터널 주소:포트)
MEDIASOUP_ANNOUNCED_ADDRESS=127.0.0.1:10000

# ============================================
# 모니터링 설정
# ============================================

# 모니터링 활성화 (true/false)
ENABLE_MONITORING=true

# 측정 간격 (밀리초)
METRICS_INTERVAL_MS=1000

# CSV 파일 출력 디렉토리
METRICS_OUTPUT_DIR=/app/metrics

# 콘솔 출력 여부 (true/false)
METRICS_CONSOLE_OUTPUT=true
